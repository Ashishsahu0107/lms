{
  "name": "lms-pro-nextjs",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "LMS Pro — Unified Next.js 15 Application (PostgreSQL + Swagger)",
  "scripts": {
    "dev": "node server.js",
    "dev:next": "next dev",
    "dev:socket": "node socket-server.js",
    "socket:start": "NODE_ENV=production node socket-server.js",
    "clean": "npx rimraf .next",
    "build": "npx rimraf .next && next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint app components lib context providers",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "tsc --noEmit && eslint app components lib context providers",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@reduxjs/toolkit": "^2.5.1",
    "@types/three": "^0.185.1",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "express-rate-limit": "^8.5.2",
    "flyonui": "^2.4.1",
    "framer-motion": "^12.38.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.14.0",
    "multer": "^1.4.5-lts.1",
    "next": "^15.0.0",
    "nodemailer": "^8.0.9",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-dist": "^5.18.0",
    "three": "^0.185.1",
    "uuid": "^11.0.0",
    "winston": "^3.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0"
  }
}
