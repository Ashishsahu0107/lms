# =========================================================================
# LMS PRO FRONTEND ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to '.env' and modify the values.
# When deploying to Vercel, set these variables in the Vercel Dashboard.
# =========================================================================

# The full HTTP URL to the deployed backend's API folder
VITE_API_URL=https://your-backend-domain.com/api

# The base API URL reference (used in specific helper layers)
VITE_API_BASE_URL=https://your-backend-domain.com/api

# The WebSocket connection URL to the backend Socket.io server (without /socket.io suffix)
VITE_SOCKET_URL=https://your-backend-domain.com
