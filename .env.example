# ==============================================================================
# LMS Pro Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SECRETS
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Prisma)
# Local: postgresql://postgres:password@localhost:5432/lms_pro
# Production (Neon, Supabase, Railway): postgresql://user:pass@ep-xyz.region.aws.neon.tech/lms_pro?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/lms_pro"

# Secret key used for signing JWT authentication tokens
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"

# Application Environment ('development' or 'production')
NODE_ENV="development"

# Server Port
PORT=3000

# JSON Request Body Limit
JSON_LIMIT="1mb"

# Uploads directory (relative to project root for local disk storage)
UPLOADS_DIR="uploads"

# ------------------------------------------------------------------------------
# 2. EMAIL / SMTP (OTP & Notifications)
# ------------------------------------------------------------------------------
# Leave SMTP_HOST empty in local dev to print OTP codes directly to console
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER="noreply@lmspro.edu"
SMTP_PASS=""
SMTP_FROM="LMS Pro <noreply@lmspro.edu>"

# ------------------------------------------------------------------------------
# 3. PUBLIC FRONTEND ENVIRONMENT VARIABLES (Vercel & Browser)
# ------------------------------------------------------------------------------
# API URL:
# - For Vercel (same-origin): leave as "/api" or leave empty (defaults to "/api")
# - For external backend: "https://api.yourdomain.com/api"
NEXT_PUBLIC_API_URL="/api"

# Socket.IO Persistent Server URL:
# - In Local Dev: "http://localhost:3000" (unified server) or "http://localhost:3001" (standalone socket server)
# - In Production (Render, Railway, Fly.io, VPS): "https://lms-socket.onrender.com"
# - If left empty in production, messaging features will gracefully use HTTP fallback
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# Public Application Name
NEXT_PUBLIC_APP_NAME="LMS Pro"

# ------------------------------------------------------------------------------
# 4. STANDALONE SOCKET.IO SERVER (Render / Railway / Fly.io / VPS)
# ------------------------------------------------------------------------------
# Allowed Frontend Origins for Socket.IO and API CORS (comma-separated if multiple)
# In development, localhost and LAN IPs are automatically allowed.
# In production, set your Vercel URL(s):
CORS_ORIGIN="https://my-lms-project.vercel.app"
FRONTEND_URL="https://my-lms-project.vercel.app"

# ------------------------------------------------------------------------------
# 5. AI SERVICES (Optional)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""

